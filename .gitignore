# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit real env values, but keep the
# checked-in .env.example templates (frontend/.env.example, backend/.env.example)
.env
.env.*
!**/.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Local-disk artwork/upload storage fallback (dev-only convenience —
# services/storage/localStorage.js — production always uses S3). Two
# leftover test-upload PNGs from earlier dev testing were previously
# tracked here by mistake (Phase 6B §81 source-control cleanliness).
backend/storage/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Legacy DB dump (removed from working tree — Phase 6B security finding, contains
# real password hashes + customer PII from the old primelinor-bulk system). This
# does not scrub it from git history (still present in commit c959954) — a full
# history rewrite (git filter-repo / BFG) is a separate, deliberate owner action.
primelinorbulk_backup.sql

# Database backups / dumps (Phase 6C-2 pre-production cleanup). Never commit —
# they contain full operational data. Prisma migration SQL (backend/prisma/
# migrations/**/migration.sql) stays tracked because only *.dump / *.sql.gz /
# the backups/ dir are ignored here, not migration.sql by name.
backups/
*.dump
*.sql.gz
*.backup
