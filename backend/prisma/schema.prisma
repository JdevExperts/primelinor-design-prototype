generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum PriceMode {
  FIXED
  TIERED
  QUOTE_ONLY
}

enum AssetType {
  CATALOG
  GALLERY_FRONT
  GALLERY_BACK
  DETAIL
  CUSTOMIZATION_FRONT
  CUSTOMIZATION_BACK
  MODEL
  TEAM
  LIFESTYLE
}

enum PlacementView {
  FRONT
  BACK
}

// ── Category ─────────────────────────────────────────────────────────────────
// Self-referencing so "subcategory" is just a Category whose parent is set —
// no separate Subcategory table, per the Phase 1 brief.

model Category {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  parentCategoryId String?  @map("parent_category_id")
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  // One primary navigation/marketing image per category, not a gallery —
  // mirrors ProductAsset's url/storageKey split (imageStorageKey null for
  // an external/unmanaged URL, set only for an object this system
  // uploaded, so deletion can safely know what it's allowed to remove).
  imageUrl         String?  @map("image_url")
  imageStorageKey  String?  @map("image_storage_key")
  imageAlt         String?  @map("image_alt")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  parent             Category?         @relation("CategoryChildren", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children           Category[]        @relation("CategoryChildren")
  // Products for which THIS is the canonical/breadcrumb category — a
  // subset of `productMemberships` below (Product↔Category M2M, Solutions
  // Phase 0). Every primary-category product also has a matching
  // ProductCategory row; this relation exists only so admin/public queries
  // that specifically need "canonical category → products" (breadcrumb,
  // legacy single-category consumers) don't have to filter the M2M table.
  primaryProducts    Product[]         @relation("ProductPrimaryCategory")
  productMemberships ProductCategory[]

  @@index([parentCategoryId])
  @@map("categories")
}

// ── Product ──────────────────────────────────────────────────────────────────
// Product↔Category is many-to-many (ProductCategory), with one membership
// distinguished as the canonical/breadcrumb category via primaryCategoryId
// (Solutions Phase 0 — audit found the original one-Category-per-product
// design too rigid once a product can legitimately serve more than one
// merchandising category, e.g. a dry-fit tee that's both T-Shirts and a
// Sports Teams & Clubs staple). `primaryCategoryId` is NOT NULL and always
// backed by a same-category `ProductCategory` row — enforced in
// src/services/catalogAdmin/productAdmin.js, not at the DB level (Prisma
// has no cross-table CHECK constraint for "this FK value must also exist
// as a row in that join table").

model Product {
  id                String    @id @default(uuid())
  slug              String    @unique
  // Permanent, human-friendly identifier for the base product (PL-[TYPE]-[NNN],
  // e.g. PL-PO-001). Never varies by size/colour/variant/quantity/pricing.
  // Stable once assigned — see src/services/productCode.js.
  productCode       String    @unique @map("product_code")
  name              String
  primaryCategoryId String    @map("primary_category_id")
  active            Boolean   @default(true)
  sortOrder         Int       @default(0) @map("sort_order")
  description       String
  longSpec          String?   @map("long_spec")
  material          String?
  gsm               Int?
  moq               Int
  unit              String    @default("piece")
  priceMode         PriceMode @map("price_mode")
  fixedPrice        Decimal?  @map("fixed_price") @db.Decimal(10, 2)
  // TIERED only. Quantities at/above this are outside priced tier coverage
  // and become quote-required even though the product otherwise has tiered
  // pricing (Phase 5 §23) — e.g. priced tiers up to 4999, "5000+ Request
  // Quote". Null means the priced tiers are the only coverage rule (no
  // separate quote-above cutoff).
  quoteAboveQty     Int?      @map("quote_above_qty")
  customizable      Boolean   @default(false)
  variantType       String?   @map("variant_type")
  dispatchEstimate  String?   @map("dispatch_estimate")
  seoTitle          String?   @map("seo_title")
  seoDescription    String?   @map("seo_description")
  createdByUserId   String?   @map("created_by_user_id")
  updatedByUserId   String?   @map("updated_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  primaryCategory Category               @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  categories      ProductCategory[]
  createdByUser   StaffUser?             @relation("ProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   StaffUser?             @relation("ProductUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  priceTiers      ProductPriceTier[]
  colors          ProductColor[]
  variants        ProductVariant[]
  specifications  ProductSpecification[]
  assets          ProductAsset[]
  placementZones  PlacementZone[]
  tags            ProductTag[]
  relatedFrom     ProductRelated[]       @relation("ProductRelatedFrom")
  relatedTo       ProductRelated[]       @relation("ProductRelatedTo")
  solutions       SolutionProduct[]
  productAttributes ProductAttribute[]

  @@index([primaryCategoryId])
  @@index([active])
  @@map("products")
}

// Ordered M2M — precedent: SolutionProduct/ProductRelated. `sortOrder` lets
// Admin control the display order of a product's "also shown under"
// categories; the primary category's own membership row still exists here
// too (its sortOrder is not load-bearing — primaryCategoryId is what makes
// it canonical, not its position in this list).
model ProductCategory {
  id         String @id @default(uuid())
  productId  String @map("product_id")
  categoryId String @map("category_id")
  sortOrder  Int    @default(0) @map("sort_order")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

// Catalog estimate pricing only — NOT negotiated quotation pricing (that's a
// Phase 2 concern living entirely outside this schema).
model ProductPriceTier {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  minQty    Int     @map("min_qty")
  maxQty    Int?    @map("max_qty")
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_price_tiers")
}

// ── Colors ───────────────────────────────────────────────────────────────────

model Color {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  hex       String?
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  products       ProductColor[]
  assets         ProductAsset[]
  placementZones PlacementZone[]

  @@map("colors")
}

model ProductColor {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  colorId   String  @map("color_id")
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([productId, colorId])
  @@index([colorId])
  @@map("product_colors")
}

// ── Variants ─────────────────────────────────────────────────────────────────
// Generic — sizes (S/M/L), volumes (500ml/750ml), formats (A4/A5), whatever a
// product needs. Deliberately not named ProductSize.

model ProductVariant {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  code      String
  label     String
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@map("product_variants")
}

// ── Specifications ───────────────────────────────────────────────────────────
// Pragmatic label/value rows rather than a generic EAV engine — keeps
// frontend display order and rendering trivial.

model ProductSpecification {
  id        String @id @default(uuid())
  productId String @map("product_id")
  label     String
  value     String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

// ── Assets ───────────────────────────────────────────────────────────────────
// ONE canonical asset model for every product image, replacing the PDP-vs-
// Studio schema split found in the frontend audit.
//
// `storageKey` is nullable deliberately: existing production S3 objects can
// be referenced by `url` alone (their real key convention isn't something
// this task reads or reproduces — see backend README). New uploads (Phase 2+)
// will populate both `storageKey` and `url`.

model ProductAsset {
  id                     String    @id @default(uuid())
  productId              String    @map("product_id")
  colorId                String?   @map("color_id")
  type                   AssetType
  storageKey             String?   @map("storage_key")
  url                    String
  alt                    String?
  sortOrder              Int       @default(0) @map("sort_order")
  active                 Boolean   @default(true)
  supportsArtworkOverlay Boolean   @default(false) @map("supports_artwork_overlay")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  color          Color?          @relation(fields: [colorId], references: [id], onDelete: SetNull)
  placementZones PlacementZone[]

  @@index([productId])
  @@index([colorId])
  @@map("product_assets")
}

// ── Placement zones ──────────────────────────────────────────────────────────
// Normalized (0–100) coordinates the frontend customization preview reads
// directly. Kept separate from ProductAsset because one asset can carry
// multiple zones, and zones describe product capability, not one photo file.

model PlacementZone {
  id           String        @id @default(uuid())
  productId    String        @map("product_id")
  colorId      String?       @map("color_id")
  assetId      String?       @map("asset_id")
  view         PlacementView
  placementKey String        @map("placement_key")
  label        String
  cx           Decimal       @db.Decimal(6, 3)
  cy           Decimal       @db.Decimal(6, 3)
  width        Decimal       @db.Decimal(6, 3)
  height       Decimal       @db.Decimal(6, 3)
  active       Boolean       @default(true)
  sortOrder    Int           @default(0) @map("sort_order")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?        @relation(fields: [colorId], references: [id], onDelete: SetNull)
  asset   ProductAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("placement_zones")
}

// ── Related products ─────────────────────────────────────────────────────────

model ProductRelated {
  id               String @id @default(uuid())
  productId        String @map("product_id")
  relatedProductId String @map("related_product_id")
  sortOrder        Int    @default(0) @map("sort_order")

  product        Product @relation("ProductRelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelatedTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@map("product_related")
}

// ── Tags (use-case attribution) ──────────────────────────────────────────────
// Lightweight tagging, not a CMS taxonomy system — covers "Corporate Teams",
// "Events", etc. so Solutions pages can eventually query real products.

model Tag {
  id   String @id @default(uuid())
  name String
  slug String @unique

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  id        String @id @default(uuid())
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

// ── Solutions (use-case merchandising pages) ────────────────────────────────
// First-class managed data replacing the frontend-only solutionsData.js
// config (Solutions Phase 1). `active` mirrors Category/Product's plain
// boolean rather than a DRAFT/ACTIVE/INACTIVE enum — the only business rule
// ("an ACTIVE Solution needs >=1 ACTIVE mapped Product") is enforced in
// src/services/catalogAdmin/solutionAdmin.js, not at the DB level, the same
// way an empty-but-active leaf Category is rejected in categoryAdmin.js
// rather than via a DB constraint. The richer per-page content (challenge
// points, benefits, process steps, feature blocks, final CTA) is kept as
// Json rather than normalized into their own tables — a pragmatic V1 that
// avoids building a general CMS for content that has no independent
// existence outside its one Solution and is always edited as a whole
// section, never queried/filtered on its own.
model Solution {
  id                 String   @id @default(uuid())
  slug               String   @unique
  name               String
  eyebrow            String?
  hubDescription     String
  heroTitle          String
  heroCopy           String
  challengeTitle     String?
  challengeCopy      String?
  challengePoints    Json?
  useCases           Json?
  benefits           Json?
  processSteps       Json?
  featureSections    Json?
  finalCta           Json?
  primaryCtaLabel    String?
  secondaryCtaLabel  String?
  secondaryCtaTo     String?
  proofTestimonialId String?  @map("proof_testimonial_id")
  // Vector-illustration fallback (ProductVisual `art`/`color`) shown until a
  // real photo is uploaded — same convention already used for Category's
  // homepage card fallback (frontend homeData.js), not a new concept.
  art                String?
  color              String?
  active             Boolean  @default(false)
  featuredOnHome     Boolean  @default(false) @map("featured_on_home")
  // Hub order (/solutions, all active solutions) — the full curated
  // merchandising order. Independent of `homeSortOrder` below: the
  // homepage's featured subset has its OWN deliberate order (verified
  // against solutionsData.js/homeData.js — "startups" sits 2nd in the hub
  // order but 5th on the homepage), so one field can't drive both.
  sortOrder          Int      @default(0) @map("sort_order")
  // Homepage order — only meaningful among featuredOnHome=true rows.
  homeSortOrder      Int      @default(0) @map("home_sort_order")
  // Same managed-image trio as Category — one hero image, not a gallery.
  imageUrl           String?  @map("image_url")
  imageStorageKey    String?  @map("image_storage_key")
  imageAlt           String?  @map("image_alt")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  products SolutionProduct[]

  @@index([active])
  @@map("solutions")
}

// Ordered M2M — precedent: ProductRelated. A Product can appear in many
// Solutions; a Solution's product list has a deterministic order via
// sortOrder, independent of the Product's own catalogue sortOrder.
model SolutionProduct {
  id         String  @id @default(uuid())
  solutionId String  @map("solution_id")
  productId  String  @map("product_id")
  sortOrder  Int     @default(0) @map("sort_order")
  featured   Boolean @default(false)

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([solutionId, productId])
  @@index([productId])
  @@map("solution_products")
}

// ═════════════════════════════════════════════════════════════════════════
// PHASE 2 — Leads, RFQs, artwork intake.
//
// Deliberately no Prisma relation from RFQItem back to Product/Color/
// ProductVariant: those catalog models are untouched from Phase 1. RFQItem
// stores plain id columns validated in application code (see
// src/services/rfqValidation.js), matching the snapshot-first design in
// the architecture doc — historical RFQs must not change if catalog data
// changes later, so the FK isn't load-bearing anyway.
// ═════════════════════════════════════════════════════════════════════════

enum LeadStatus {
  NEW
  IN_REVIEW
  CONVERTED
  CLOSED
}

enum RfqStatus {
  NEW
  IN_PROGRESS
  QUOTED
  NEGOTIATING
  WON
  LOST
  CANCELLED
}

enum ArtworkStatus {
  PENDING
  ATTACHED
  DELETED
}

/**
 * Where a Lead/RFQ came from — the frontend surface, not marketing UTM.
 */
enum SourceType {
  HEADER_QUOTE
  PDP
  CUSTOMIZATION_STUDIO
  CORPORATE_GIFTING
  KIT_BUILDER
  SOLUTION
  CONTACT
  ABOUT
  OTHER
}

// ── Contact / Company ────────────────────────────────────────────────────────
// Phone is the primary dedup key (see src/services/contact.js) — this is a
// WhatsApp-first B2B audience, not an email-first one. Company matching is
// deliberately conservative: exact case-insensitive name match only, never
// fuzzy, so unrelated companies never get merged.

model Company {
  id        String   @id @default(uuid())
  name      String
  domain    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts Contact[]

  @@map("companies")
}

model Contact {
  id             String   @id @default(uuid())
  name           String
  phone          String   @unique // normalized, e.g. +91XXXXXXXXXX — see normalizePhone()
  phoneRaw       String   @map("phone_raw") // as originally typed, for display/audit only
  email          String?
  companyId      String?  @map("company_id")
  companyNameRaw String?  @map("company_name_raw")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads   Lead[]
  rfqs    RFQ[]

  @@map("contacts")
}

// ── Lead ─────────────────────────────────────────────────────────────────────
// An enquiry with no concrete priceable requirement yet (Contact form, a
// bare "Request a Quote" click with no product/quantity attached).

model Lead {
  id               String     @id @default(uuid())
  reference        String     @unique
  contactId        String     @map("contact_id")
  status           LeadStatus @default(NEW)
  sourceType       SourceType @map("source_type")
  sourcePath       String     @map("source_path")
  sourceContext    Json?      @map("source_context")
  utmSource        String?    @map("utm_source")
  utmMedium        String?    @map("utm_medium")
  utmCampaign      String?    @map("utm_campaign")
  utmContent       String?    @map("utm_content")
  message          String
  submissionId     String     @unique @map("submission_id")
  assignedToUserId String?    @map("assigned_to_user_id")
  convertedRfqId   String?    @map("converted_rfq_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  rfqs    RFQ[]

  @@index([contactId])
  @@index([status])
  @@map("leads")
}

// ── RFQ ──────────────────────────────────────────────────────────────────────
// A concrete, priceable request. Estimated pricing on its items is a frozen
// snapshot computed server-side at submission time — see
// src/services/pricingEstimate.js — never the frontend's number, and never
// overwritten later (a future Quotation is a separate, versioned entity).

model RFQ {
  id               String     @id @default(uuid())
  reference        String     @unique
  contactId        String     @map("contact_id")
  leadId           String?    @map("lead_id")
  status           RfqStatus  @default(NEW)
  sourceType       SourceType @map("source_type")
  sourcePath       String     @map("source_path")
  sourceContext    Json?      @map("source_context")
  utmSource        String?    @map("utm_source")
  utmMedium        String?    @map("utm_medium")
  utmCampaign      String?    @map("utm_campaign")
  utmContent       String?    @map("utm_content")
  message          String?
  deliveryCity     String?    @map("delivery_city")
  deliveryPin      String?    @map("delivery_pin")
  currency         String     @default("INR")
  requirementData  Json?      @map("requirement_data")
  submissionId     String     @unique @map("submission_id")
  assignedToUserId String?    @map("assigned_to_user_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Restrict)
  lead         Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedTo   StaffUser?       @relation("RFQAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  // Immutable customer-submitted items — the historical source of truth.
  items        RFQItem[]
  // Editable sales requirement used during negotiation (Phase C). Seeded
  // once from `items` at RFQ creation; never writes back to `items`.
  workingItems RfqWorkingItem[]
  activity     RFQActivity[]
  notes        InternalNote[]
  quotations   Quotation[]

  @@index([contactId])
  @@index([status])
  @@index([leadId])
  @@index([assignedToUserId])
  @@map("rfqs")
}

model RFQItem {
  id    String @id @default(uuid())
  rfqId String @map("rfq_id")

  // Real catalogue product (nullable — a Kit Builder item may have none).
  productId   String? @map("product_id")
  // Described/custom item — required when productId is absent.
  description String?

  // Snapshots — frozen at submission time, never re-derived from live data.
  productNameSnapshot  String? @map("product_name_snapshot")
  productSlugSnapshot  String? @map("product_slug_snapshot")
  productCodeSnapshot  String? @map("product_code_snapshot")
  specSnapshot         String? @map("spec_snapshot")
  colorId              String? @map("color_id")
  colorNameSnapshot    String? @map("color_name_snapshot")
  variantId            String? @map("variant_id")
  variantLabelSnapshot String? @map("variant_label_snapshot")
  unitSnapshot         String? @map("unit_snapshot")
  pricingModeSnapshot  String? @map("pricing_mode_snapshot")

  quantity           Int?
  // Server-computed at submission — see §12 of the Phase 2 brief. Never
  // trusted from the client, never mutated after creation.
  estimatedUnitPrice Decimal? @map("estimated_unit_price") @db.Decimal(10, 2)
  estimatedTotal     Decimal? @map("estimated_total") @db.Decimal(10, 2)

  // { front: {enabled, placementKey, artworkAssetId}, back: {...} }
  customizationData Json? @map("customization_data")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  rfq            RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  artworks       ArtworkAsset[]
  quotationLines QuotationLine[]

  @@index([rfqId])
  @@map("rfq_items")
}

// ── RFQ working requirement (Phase C) ────────────────────────────────────────
// The editable sales requirement. Distinct from RFQItem so the customer's
// original submission stays immutable. Seeded once from RFQItem at RFQ
// creation (and backfilled for legacy RFQs); after that ADMIN/SALES edit
// freely — change quantities, add catalogue or custom lines, remove lines.
// A new quotation snapshots THIS, not RFQItem. Never syncs back.

model RfqWorkingItem {
  id                   String   @id @default(uuid())
  rfqId                String   @map("rfq_id")
  // Null for a custom/described line.
  productId            String?  @map("product_id")
  productCodeSnapshot  String?  @map("product_code_snapshot")
  productNameSnapshot  String?  @map("product_name_snapshot")
  description          String?
  quantity             Int?
  unit                 String?
  specSnapshot         String?  @map("spec_snapshot")
  colorNameSnapshot    String?  @map("color_name_snapshot")
  variantLabelSnapshot String?  @map("variant_label_snapshot")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@map("rfq_working_items")
}

// ── RFQ activity ─────────────────────────────────────────────────────────────
// Append-only. `type` is a plain string, not an enum, so later phases (admin
// status changes, quotation events) can add new event types without a
// migration — validated against a known list in application code for now.

model RFQActivity {
  id        String   @id @default(uuid())
  // Nullable since Phase E: a MANUAL (standalone) quotation has no RFQ, so
  // its lifecycle events are scoped to `quotationId` instead. Exactly one
  // of rfqId / quotationId is set on any row.
  rfqId       String?  @map("rfq_id")
  quotationId String?  @map("quotation_id")
  type        String
  actorType   String   @map("actor_type") // "SYSTEM" | "CUSTOMER" | "STAFF"
  // Loose reference, not a FK — actorId's meaning depends on actorType
  // (a StaffUser.id for "STAFF", absent otherwise), so a single relation
  // column would be wrong for two of the three actor types.
  actorId   String?  @map("actor_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  rfq       RFQ?       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@index([quotationId])
  @@map("rfq_activity")
}

// ── Artwork ──────────────────────────────────────────────────────────────────
// Customer-provided private source artwork — distinct from ProductAsset
// (public catalogue media). Private storage, signed access only, never a
// permanent public URL. See src/services/storage.js.

model ArtworkAsset {
  id                String        @id @default(uuid())
  status            ArtworkStatus @default(PENDING)
  originalFileName  String        @map("original_file_name")
  mimeType          String        @map("mime_type")
  size              Int
  storageKey        String        @map("storage_key")
  previewStorageKey String?       @map("preview_storage_key")
  expiresAt         DateTime?     @map("expires_at")
  rfqItemId         String?       @map("rfq_item_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  attachedAt        DateTime?     @map("attached_at")

  rfqItem RFQItem? @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@map("artwork_assets")
}

// ═════════════════════════════════════════════════════════════════════════
// PHASE 3 — Staff auth, RFQ admin workflow, versioned quotations.
// ═════════════════════════════════════════════════════════════════════════

enum StaffRole {
  ADMIN
  SALES
}

/**
 * No public signup — rows are created via prisma/createStaffUser.js only.
 */
model StaffUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         StaffRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  assignedRfqs      RFQ[]          @relation("RFQAssignedTo")
  internalNotes     InternalNote[]
  quotationsCreated Quotation[]
  productsCreated   Product[]      @relation("ProductCreatedBy")
  productsUpdated   Product[]      @relation("ProductUpdatedBy")

  @@map("staff_users")
}

// Private staff note. Scoped to an RFQ OR a quotation lineage — exactly
// one of rfqId / quotationId is set. A quotation-scoped note lets sales
// keep negotiation history against a standalone (MANUAL) quotation that
// has no RFQ. Never exposed on any public endpoint or in the PDF.
model InternalNote {
  id           String   @id @default(uuid())
  rfqId        String?  @map("rfq_id")
  quotationId  String?  @map("quotation_id")
  authorUserId String   @map("author_user_id")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rfq       RFQ?       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  author    StaffUser  @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([rfqId])
  @@index([quotationId])
  @@map("internal_notes")
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  SUPERSEDED
  // Staff-voided a mistakenly issued quotation. Distinct from REJECTED
  // (a customer decision). Record preserved; customer link deactivated.
  CANCELLED
}

enum QuotationOrigin {
  RFQ
  MANUAL
  PHONE
  WHATSAPP
  OFFLINE
}

// ── Quotation ────────────────────────────────────────────────────────────────
// One row = one immutable-once-sent version. `subtotal`/`grandTotal` are
// always server-computed from this quotation's QuotationLine rows (see
// src/services/quotationTotals.js) — a client-submitted total is never
// trusted, mirroring the RFQItem pricing rule from Phase 2. `taxMode` is a
// free-text label only ("GST 18% exclusive", etc.) — there is no tax-rate
// engine yet; `taxAmount` is a manually entered figure that totals simply
// add in, deliberately deferring any GST inclusive/exclusive policy
// decision to a later phase.
model Quotation {
  id              String          @id @default(uuid())
  // RFQ = created from an RFQ's working requirement; MANUAL = standalone
  // (customer called / WhatsApp / repeat / walk-in) — same engine, editor,
  // PDF and public page (Phase E / AA-3).
  originType      QuotationOrigin @default(RFQ) @map("origin_type")
  // Free-text detail on how a non-RFQ quotation arrived ("WhatsApp enquiry
  // from +91…", "Office meeting", "Direct call"). Optional.
  originDetail    String?         @map("origin_detail")
  // Nullable — null for MANUAL. No fake RFQ is ever created.
  rfqId           String?         @map("rfq_id")
  // Shared by every version (V1/V2/V3) of one quotation lineage. For an
  // RFQ-origin lineage this equals the rfqId; for MANUAL it is a fresh id
  // minted on V1 and reused by revisions. Versioning keys off this.
  quotationGroupId String         @map("quotation_group_id")
  // Customer-facing group number for MANUAL lineages (PL-QT-YYYY-NNNNNN).
  // Null for RFQ-origin, which reuses the RFQ reference (historical compat).
  groupReference  String?         @map("group_reference")
  version         Int
  supersedesId    String?         @unique @map("supersedes_id")
  status          QuotationStatus @default(DRAFT)
  currency        String          @default("INR")

  // ── Party snapshot (AA-2) — the commercial counterparty, frozen on the
  // quotation. Populated from RFQ/Contact for RFQ-origin, entered directly
  // for MANUAL. Not a CRM model.
  partyName          String? @map("party_name")
  partyContactPerson String? @map("party_contact_person")
  partyPhone         String? @map("party_phone")
  partyEmail         String? @map("party_email")
  partyGstin         String? @map("party_gstin")
  partyAddress       String? @map("party_address")

  subtotal        Decimal         @default(0) @db.Decimal(10, 2)
  taxMode         String?         @map("tax_mode")
  taxAmount       Decimal?        @map("tax_amount") @db.Decimal(10, 2)
  grandTotal      Decimal         @default(0) @map("grand_total") @db.Decimal(10, 2)
  validUntil      DateTime?       @map("valid_until")
  customerNotes   String?         @map("customer_notes")
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  sentAt          DateTime?       @map("sent_at")
  viewedAt        DateTime?       @map("viewed_at")
  respondedAt     DateTime?       @map("responded_at")
  cancelledAt     DateTime?       @map("cancelled_at")
  cancelReason    String?         @map("cancel_reason")

  // ── Customer access token (Phase 4 §3) ──────────────────────────────────
  // Only the SHA-256 hash is stored — the raw token is returned once, at
  // generation time (on send, or on regenerate), and never persisted.
  // Human-readable references (RFQ reference, quotation version) must never
  // grant access on their own; only possession of the raw token, verified
  // against this hash, does.
  accessTokenHash      String?   @unique @map("access_token_hash")
  accessTokenCreatedAt DateTime? @map("access_token_created_at")
  accessTokenRevokedAt DateTime? @map("access_token_revoked_at")

  rfq          RFQ?            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  createdBy    StaffUser       @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  // The prior version this one revises — set only on the NEW row created by
  // a revision. The prior row only flips to SUPERSEDED once this new row is
  // actually SENT (Phase 3 §24), not merely on draft creation.
  supersedes   Quotation?      @relation("QuotationSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy Quotation?      @relation("QuotationSupersedes")
  lines         QuotationLine[]
  activity      RFQActivity[]
  internalNotes InternalNote[]

  @@unique([quotationGroupId, version])
  @@index([rfqId])
  @@index([quotationGroupId])
  @@index([status])
  @@map("quotations")
}

enum QuotationLineType {
  PRODUCT
  SHIPPING
  DISCOUNT
  ADJUSTMENT
}

// ── Quotation line ───────────────────────────────────────────────────────────
// `lineTotal` is server-computed as quantity * unitPrice whenever both are
// present (PRODUCT/SHIPPING lines); DISCOUNT/ADJUSTMENT lines — and any
// PRODUCT/SHIPPING line without a quantity/unitPrice decomposition, e.g. a
// flat custom-branding fee — carry a directly staff-entered lineTotal
// instead. DISCOUNT lines must be <= 0, enforced in
// src/validation/quotations.schema.js. This is the one consistent
// mechanism for every commercial adjustment — there is no separate
// "discount %" or hidden total-override field.
model QuotationLine {
  id          String            @id @default(uuid())
  quotationId String            @map("quotation_id")
  rfqItemId   String?           @map("rfq_item_id")
  lineType    QuotationLineType @map("line_type")
  description String
  // Catalogue product this line represents, when it is a PRODUCT line
  // backed by the catalogue. Loose reference (no FK relation) — the line's
  // commercial identity lives in the *Snapshot columns and must survive
  // the product being renamed, recoded or deleted (§18/§59).
  productId           String? @map("product_id")
  productNameSnapshot String? @map("product_name_snapshot")
  // Product Code frozen when this quotation version was created (§16) —
  // copied from the linked RFQItem's snapshot, never re-read from live data.
  productCodeSnapshot String? @map("product_code_snapshot")
  quantity    Int?
  unit        String?
  unitPrice   Decimal?          @map("unit_price") @db.Decimal(10, 2)
  // Nullable: a PRODUCT/SHIPPING line may sit in a DRAFT with a quantity
  // but no rate yet ("rate required"). Never null on a SENT quotation —
  // send validation blocks that (§11/§12).
  lineTotal   Decimal?          @map("line_total") @db.Decimal(10, 2)
  sortOrder   Int               @default(0) @map("sort_order")
  metadata    Json?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem   RFQItem?  @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_lines")
}

// ═════════════════════════════════════════════════════════════════════════
// PHASE 6C-1 — First-party website analytics.
// ═════════════════════════════════════════════════════════════════════════

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  PRODUCT_CARD_CLICK
  CATEGORY_VIEW
  SOLUTION_VIEW
  SEARCH
  QUOTE_CTA_CLICK
  RFQ_STARTED
  RFQ_SUBMITTED
  WHATSAPP_CLICK
  CONTACT_CLICK
}

// One business-relevant interaction on the public website. Deliberately
// small and privacy-conservative: NO raw IP column exists — approximate
// geo (country/state/city) is derived at ingest from an edge/proxy header
// when available and left null otherwise; the User-Agent is reduced to a
// device category and not stored. `visitorId`/`sessionId` are anonymous
// client-generated identifiers, never a fingerprint. Admin (`/admin/*`)
// and token quote (`/quote/*`) paths are never recorded here.
model AnalyticsEvent {
  id                String             @id @default(uuid())
  eventType         AnalyticsEventType @map("event_type")
  visitorId         String?            @map("visitor_id")
  sessionId         String?            @map("session_id")
  path              String?
  referrer          String?
  referrerGroup     String?            @map("referrer_group")
  utmSource         String?            @map("utm_source")
  utmMedium         String?            @map("utm_medium")
  utmCampaign       String?            @map("utm_campaign")
  productId         String?            @map("product_id")
  productCode       String?            @map("product_code")
  categoryId        String?            @map("category_id")
  solutionId        String?            @map("solution_id")
  searchQuery       String?            @map("search_query")
  searchResultCount Int?               @map("search_result_count")
  deviceType        String?            @map("device_type")
  country           String?
  state             String?
  city              String?
  metadata          Json?
  // Marks controlled dev/QA rows so Phase 6C-2 pre-production cleanup can
  // delete them with a single `WHERE is_test = true`.
  isTest            Boolean            @default(false) @map("is_test")
  createdAt         DateTime           @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([createdAt])
  @@index([productId, eventType])
  @@index([visitorId])
  @@index([sessionId])
  @@index([isTest])
  @@map("analytics_events")
}

// ═════════════════════════════════════════════════════════════════════════
// Generic Product Attribute framework — flexible internal/operational
// product metadata that must NOT become permanent first-class columns.
// Core catalogue fields (code, name, slug, MOQ, pricing, category, active,
// customization, variants, colours) stay first-class; this is only for
// flags / temporary metadata / lightweight internal controls.
// ═════════════════════════════════════════════════════════════════════════

enum ProductAttributeValueType {
  BOOLEAN
  STRING
  NUMBER
  JSON
}

// Declares an attribute: its machine key, display name, and the value
// type the service layer validates assignments against. Seeded via
// migration/backfill for now — no arbitrary-config Admin UI in this phase.
model ProductAttributeConfig {
  id          String                    @id @default(uuid())
  // Machine-readable, unique. UPPER_SNAKE_CASE convention (e.g.
  // PRODUCT_REVIEW_PENDING).
  key         String                    @unique
  name        String
  valueType   ProductAttributeValueType @map("value_type")
  description String?
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  attributes ProductAttribute[]

  @@map("product_attribute_configs")
}

// One value of one attribute config for one product. `attributeId` (not
// attributeConfigId) points at ProductAttributeConfig.id. At most one row
// per (product, attribute). Value is JSONB; the service validates it
// against the config's valueType before write.
model ProductAttribute {
  id          String   @id @default(uuid())
  attributeId String   @map("attribute_id")
  productId   String   @map("product_id")
  value       Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Restrict: a config may be reused operationally — a casual config
  // delete must not silently erase every product's attribute row.
  attribute ProductAttributeConfig @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  // Cascade: deleting a product cleans up its attribute rows.
  product   Product                @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId])
  @@index([productId])
  @@map("product_attributes")
}
